# 复制为 .env 后按实际环境填写。.env 已被 .gitignore 忽略，切勿提交。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 本地开发：本机安装的 PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kdblog?schema=public"

# 以下三项仅 docker-compose 使用（用于创建容器内的库与账号）。
# 本机开发直接连本地 PostgreSQL 时无需填写。
# 注意：改动这里后 DATABASE_URL 也要同步，compose 中主机名为 db 而非 localhost，
# 例：postgresql://kdblog:密码@db:5432/kdblog?schema=public
POSTGRES_USER="kdblog"
POSTGRES_PASSWORD="请替换为强密码"
POSTGRES_DB="kdblog"

# 容器对外暴露的端口，仅 docker-compose 使用
APP_PORT=3000

# ---------------------------------------------------------------------------
# 认证（Auth.js）
# ---------------------------------------------------------------------------
# 生成方式：openssl rand -base64 32
AUTH_SECRET="请替换为随机字符串"
# 生产环境必须为 true，否则 Cookie 的 secure 标记不会生效
AUTH_TRUST_HOST=true

# 初始管理员账号，仅被 prisma/seed.ts 读取，创建后可从环境中移除
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="请替换为强密码"
SEED_ADMIN_NAME="管理员"

# ---------------------------------------------------------------------------
# 站点
# ---------------------------------------------------------------------------
# 用于生成 canonical、OpenGraph 与 sitemap 中的绝对地址，末尾不带斜杠
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="kdblog"
# ogImage 三级回退的最后一级
NEXT_PUBLIC_DEFAULT_OG_IMAGE="/og-default.png"

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
# 上传文件的落盘目录，生产环境由 Docker volume 挂载
UPLOAD_DIR="./uploads"

# 草稿预览链接的签名密钥，与 AUTH_SECRET 分开以便单独轮换
PREVIEW_SECRET="请替换为随机字符串"
